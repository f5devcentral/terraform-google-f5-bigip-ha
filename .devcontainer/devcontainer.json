{
    "name": "f5devcentral-terraform-google-f5-bigip-ha",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "features": {
        "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
            "moby": false
        },
        "ghcr.io/devcontainers/features/node:2": {},
        "ghcr.io/memes/devcontainers-features/direnv:1": {},
        "ghcr.io/memes/devcontainers-features/google-cloud-cli:1": {},
        "ghcr.io/memes/devcontainers-features/opentofu:1": {
            "version": "1.13.2"
        },
        "ghcr.io/memes/devcontainers-features/talisman:1": {
            "version": "1.37.0"
        },
        "ghcr.io/memes/devcontainers-features/terraform-docs:1": {
            "version": "0.24.0"
        },
        "ghcr.io/memes/devcontainers-features/tflint:1": {
            "version": "0.65.0"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "FanaticPythoner.better-todo-tree",
                "ms-python.python",
                "ms-python.debugpy",
                "ms-python.vscode-python-envs",
                "redhat.vscode-yaml",
                "streetsidesoftware.code-spell-checker",
                "tamasfe.even-better-toml",
                "opentofu.vscode-opentofu",
                "esbenp.prettier-vscode",
                "DavidAnson.vscode-markdownlint",
                "hashicorp.hcl",
                "charliermarsh.ruff",
                "astral-sh.ty"
            ],
            "settings": {
                "python.languageServer": "None"
            }
        }
    },
    "onCreateCommand": {
        "install-deps": "sudo sh -c 'apt update && apt install -y --no-install-recommends fzf shellcheck && rm -rf /var/lib/apt/lists/*'",
        "install-uv": ["/usr/local/py-utils/bin/pipx", "install", "uv"],
        "modify-default-omz-plugins": ["/usr/bin/sed", "-i.onCreateCommand" , "-e", "/^plugins=/c\\plugins=(git dotenv)", "/home/vscode/.zshrc"]
    },
    "updateContentCommand": {
        "uv-sync": "uv sync --link-mode=copy --all-extras --all-packages && uv run pre-commit install --hook-type commit-msg --hook-type pre-commit"
    },
    "containerUser": "vscode",
    "containerEnv": {
        "UV_LINK_MODE": "copy",
        // TODO(@memes): Workaround for uv sync and docker/macOS/virtiofs issue
        // "UV_PROJECT_ENVIRONMENT": "/home/vscode/.venv",
        "CLOUDSDK_CORE_CUSTOM_CA_CERTS_FILE": "/etc/ssl/certs/ca-certificates.crt",
        "GRPC_DEFAULT_SSL_ROOTS_FILE_PATH": "/etc/ssl/certs/ca-certificates.crt",
        "REQUESTS_CA_BUNDLE": "/etc/ssl/certs/ca-certificates.crt",
        "SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.crt"
    },
    "updateRemoteUserUID": true,
    "mounts": [
        "source=${localEnv:HOME}/.config/gcloud,target=/home/vscode/.config/gcloud,type=bind,consistency=cached",
        "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached"
    ]
}
